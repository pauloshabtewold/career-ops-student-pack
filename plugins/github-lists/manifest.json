{
  "id": "github-lists",
  "version": "1.3.0",
  "apiVersion": 1,
  "description": "Reads public GitHub internship and new-grad job lists, keeps the postings that fit the student's graduation cycle, and resolves aggregator links to the employer posting.",
  "hooks": ["ingest"],
  "jobPostings": true,
  "humanInTheLoop": true,
  "requiredEnv": [],
  "allowedHosts": [
    "raw.githubusercontent.com",
    "api.github.com",
    "boards-api.greenhouse.io",
    "api.lever.co",
    "api.ashbyhq.com",
    "jobs.ashbyhq.com",
    "boards.greenhouse.io",
    "jobs.lever.co",
    "zapply.jobs",
    "simplify.jobs",
    "jobright.ai"
  ]
}
