{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personalization interview answers",
  "type": "object",
  "required": [
    "identity",
    "presets",
    "tracks",
    "locations",
    "work_authorization",
    "archetypes",
    "timezone",
    "schedule_time",
    "resume_variants",
    "application_profile"
  ],
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "github": {
          "type": "string"
        }
      }
    },
    "cv_markdown": {
      "type": "string"
    },
    "cv_path": {
      "type": "string"
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "graduation",
          "resume_variant"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "internship",
              "coop",
              "newgrad"
            ]
          },
          "graduation": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "resume_variant": {
            "type": "string"
          }
        }
      }
    },
    "experience_years": {
      "type": "integer",
      "minimum": 0
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "work_authorization": {
      "type": "string",
      "minLength": 1
    },
    "dealbreakers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority_companies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blacklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_employers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "careers_url"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "careers_url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "sources_chosen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mailbox_backend": {
      "enum": [
        "connector",
        "paste",
        "gmail-plugin"
      ]
    },
    "spend_tier": {
      "enum": [
        "standard",
        "premium"
      ]
    },
    "automation": {
      "enum": [
        "manual",
        "scheduled-discovery",
        "scheduled-discovery-plus-triage"
      ]
    },
    "daily_target": {
      "type": "integer",
      "minimum": 1
    },
    "score_floor": {
      "type": "number",
      "minimum": 0
    },
    "linkedin_tier": {
      "enum": [
        "free",
        "premium"
      ]
    },
    "switches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outreach": {
          "enum": [
            "on",
            "drafts",
            "off"
          ]
        },
        "handshake": {
          "enum": [
            "on",
            "off"
          ]
        },
        "submission": {
          "enum": [
            "user",
            "agent"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "schedule_time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "resume_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "track",
          "graduation",
          "page_limit"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "track": {
            "type": "string"
          },
          "graduation": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "page_limit": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "archetypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "needs_sponsorship": {
      "type": "boolean"
    },
    "us_citizen": {
      "type": "boolean"
    },
    "application_profile": {
      "type": "object",
      "required": [
        "start_date",
        "relocation",
        "eeo",
        "how_did_you_hear"
      ],
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "type": "string",
          "pattern": "^(\\d{4}-(0[1-9]|1[0-2])|immediately)$"
        },
        "relocation": {
          "enum": [
            "yes",
            "no",
            "within-locations"
          ]
        },
        "eeo": {
          "enum": [
            "leave-blank",
            "ask-each-time"
          ],
          "default": "leave-blank"
        },
        "how_did_you_hear": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
